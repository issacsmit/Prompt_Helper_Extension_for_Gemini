{
  "manifest_version": 3,
  "name": "提示词工具 (Prompt Helper)",
  "version": "1.0.1",
  "description": "在 Gemini 网页版中快速插入预设提示词，并将光标准确定位到占位符位置。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://gemini.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": [
        "constants.js",
        "prompt-engine.js",
        "storage.js",
        "gemini-editor.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
